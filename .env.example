# Google Sheets Configuration
# Set to 'true' to enable Google Sheets integration, 'false' to use mock data
VITE_USE_GOOGLE_SHEETS=false

# Your Google Sheets Spreadsheet ID (found in the URL)
# Example: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
VITE_GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google API Key (from Google Cloud Console)
# Instructions: See GOOGLE_SHEETS_SETUP.md
VITE_GOOGLE_API_KEY=your_google_api_key_here
